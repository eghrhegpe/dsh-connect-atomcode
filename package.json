{
  "name": "dsh-connect-atomcode",
  "displayName": "DSH AtomCode Bridge",
  "icon": "./icon.svg",
  "version": "0.5.0",
  "description": "Spend your locally signed-in AtomGit's free quota on an independent code review: `atomcode_ask` is the model-side tool (its own tool loop — it decides which files to read); `/atomcode-review` is your one-click command for a diff self-check on uncommitted changes, a branch, or a PR. No API key, no model takeover.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "atomcode",
    "bridge",
    "tools"
  ],
  "type": "module",
  "author": "Yinyuan34513",
  "homepage": "https://github.com/eghrhegpe/dsh-connect-atomcode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eghrhegpe/dsh-connect-atomcode.git"
  },
  "bugs": {
    "url": "https://github.com/eghrhegpe/dsh-connect-atomcode/issues"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "icon.svg",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "coverage": "node scripts/test.mjs --coverage",
    "test": "node scripts/test.mjs",
    "test:live": "node --test test/daemon-live.test.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-settings": ">=0.1.5 <0.3",
    "@deepseek-ai/dsh-tools": ">=0.1.5 <0.3",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3"
  }
}